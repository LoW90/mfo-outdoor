<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- if settings.preview_noindex -%}<meta name="robots" content="noindex,nofollow,noarchive">{%- endif -%}
  <title>{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  <meta name="description" content="{{ page_description | default: settings.default_description | escape }}">
  <meta name="theme-color" content="#12100c">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:description" content="{{ page_description | default: settings.default_description | escape }}">
  {%- render 'mf-seo' -%}
  {{ 'playfair-display-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'outdoor-estate.css' | asset_url | stylesheet_tag }}
  {%- comment -%} mfe-planner-layer {%- endcomment -%}{{ 'mfe-planner.css' | asset_url | stylesheet_tag }}
  <style>:root{--hero:none;--mfs-hero:var(--hero);--mfr-hero:var(--hero)}</style>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }} mf-site mf-site--sauna">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  <div id="publicSite">
    {% sections 'header-group' %}
    <div id="MainContent" tabindex="-1">{{ content_for_layout }}</div>
    {% sections 'footer-group' %}
  </div>
  <div id="toast" role="status" aria-live="polite"></div>
