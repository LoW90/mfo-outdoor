{%- comment -%} Generated by shopify/build.mjs from catalog.json. Do not edit; rebuild. {%- endcomment -%}
<div class="mf-room mf-site__page"><section class="mf-room__band"><div class="mf-room__shell">
  <div class="mf-room__head"><div><p class="mf-room__eyebrow mf-room__eyebrow--gold">The Outdoor Estate</p><h1>{{ collection.title | default: 'Product library' | escape }}</h1></div><p>Every researched piece, with dated prices and the merchant that sells it.</p></div>
  {%- assign mf_list = collection.products -%}
  {%- if mf_list.size > 0 -%}<div class="mf-room__grid">{%- for p in mf_list -%}{%- if p.object_type == 'product' or p.handle -%}{% render 'mfe-card', handle: p.handle %}{%- endif -%}{%- endfor -%}</div>
  {%- else -%}<p class="mf-site__empty">No pieces in this collection yet. <a href="{{ routes.root_url }}#shop">See the full collection</a></p>{%- endif -%}
</div></section></div>
{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
