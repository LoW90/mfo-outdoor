{%- comment -%} Generated by shopify/build.mjs from catalog.json. Do not edit; rebuild. {%- endcomment -%}
<div class="mf-room mf-site__page"><section class="mf-room__band"><div class="mf-room__shell">
  <div class="mf-room__head"><div><p class="mf-room__eyebrow mf-room__eyebrow--gold">Search</p><h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search the collection{% endif %}</h1></div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="mf-site__search"><label for="mf-search-q">Search</label><input id="mf-search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Maker or piece"><button type="submit">Search</button></form></div>
  {%- assign mf_list = search.results -%}
  {%- if mf_list.size > 0 -%}<div class="mf-room__grid">{%- for p in mf_list -%}{%- if p.object_type == 'product' or p.handle -%}{% render 'mfe-card', handle: p.handle %}{%- endif -%}{%- endfor -%}</div>
  {%- else -%}<p class="mf-site__empty">{% if search.performed %}Nothing matched. Try a maker name.{% else %}Type a maker or piece above.{% endif %} <a href="{{ routes.root_url }}#shop">See the full collection</a></p>{%- endif -%}
</div></section></div>
{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
