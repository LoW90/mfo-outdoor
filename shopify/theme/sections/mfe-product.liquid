{%- comment -%} Generated by shopify/build.mjs from catalog.json. Do not edit; rebuild. {%- endcomment -%}
<div class="mf-room mf-site__page">
<section class="mf-room__band" data-mf-room-product="{{ product.handle }}"><div class="mf-room__shell mf-site__product">
  <div class="mf-site__product-media">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600, 1000, 1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title }}{%- else -%}{%- case product.handle -%}{%- else -%}<div class="mf-site__frame"><span>{{ product.vendor | escape }}</span></div>{%- endcase -%}{%- endif -%}</div>
  {% render 'mfe-research', handle: product.handle, product: product %}
</div></section>
{%- capture mf_peer_list -%}{%- case product.handle -%}{%- when 'kalamazoo-k1000' -%}kalamazoo-k750,hestan42,lynx42{%- when 'kalamazoo-k750' -%}kalamazoo-k1000,hestan42,lynx42{%- when 'hestan42' -%}kalamazoo-k1000,kalamazoo-k750,lynx42{%- when 'lynx42' -%}kalamazoo-k1000,kalamazoo-k750,hestan42{%- when 'blaze44' -%}kalamazoo-k1000,kalamazoo-k750,hestan42{%- when 'blaze34' -%}kalamazoo-k1000,kalamazoo-k750,hestan42{%- when 'traeger-timberline' -%}beatbot{%- when 'bromic53' -%}bromic33,bromic500,breeo{%- when 'bromic33' -%}bromic53,bromic500,breeo{%- when 'bromic500' -%}bromic53,bromic33,breeo{%- when 'breeo' -%}bromic53,bromic33,bromic500{%- when 'beatbot' -%}traeger-timberline{%- endcase -%}{%- endcapture -%}
{%- assign mf_peer_handles = mf_peer_list | strip | split: ',' -%}
{%- if mf_peer_handles.size > 0 -%}
<section class="mf-room__band mf-site__peers" aria-labelledby="mf-peers-title"><div class="mf-room__shell">
  <div class="mf-room__head"><div><p class="mf-room__eyebrow mf-room__eyebrow--gold">Compare with</p><h2 id="mf-peers-title">Close alternatives</h2></div><p>Pieces of the same kind or from the same maker.</p></div>
  <div class="mf-room__grid">{%- for h in mf_peer_handles -%}{% render 'mfe-card', handle: h %}{%- endfor -%}</div>
</div></section>
{%- endif -%}
<div class="mf-room__ask" id="ask"><div class="mf-room__shell"><div><h3>Planning a terrace or outdoor kitchen?</h3><p>Tell us the space and we will reply within one business day.</p></div><a href="/pages/contact?topic=specialist&amp;store=mfo-outdoor" data-mf-placement="odest" data-mf-cta="ask">Ask an outdoor specialist</a></div></div>
</div>
{% schema %}
{
  "name": "Product research",
  "settings": []
}
{% endschema %}
